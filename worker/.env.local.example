# Worker environment variables
NODE_ENV=development

# Worker URLs
PODCAST_WORKER_URL=http://localhost:8787
PODCAST_R2_BUCKET_URL=http://localhost:8787/static
# Production: set this URL and the PODCAST_SITE_SERVICE binding in Worker Wrangler config.
PODCAST_SITE_URL=http://localhost:3000

# Podcast identity
PODCAST_ID=any-podcast

# OpenCode Go (text generation; ai.provider=opencode)
OPENCODE_API_KEY=
# Optional: overrides the Admin model for OpenCode (Chat Completions models).
OPENCODE_MODEL=deepseek-v4.1-flash

# Gemini (optional)
# GEMINI_API_KEY=your_gemini_key

# MiniMax (optional, for text generation)
# MINIMAX_API_KEY=your_minimax_key

# OpenAI (optional)
# OPENAI_API_KEY=your_openai_key

# Jina (optional)
# JINA_KEY=your_jina_key

# Gmail newsletter (optional)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_USER_EMAIL=

# MiniMax TTS (optional)
# MINIMAX_TTS_GROUP_ID=
# MINIMAX_TTS_API_KEY=

# Murf TTS (optional)
# MURF_API_KEY=

# Admin
ADMIN_TOKEN=

TRIGGER_TOKEN=

# Configure AI provider/model, workflow tests, sources, prompts and TTS in Admin.
# OPENCODE_MODEL above is an optional override for the OpenCode model.
