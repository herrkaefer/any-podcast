/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "any-podcast-worker",
  "main": "./index.ts",
  "minify": true,
  "upload_source_maps": true,
  "compatibility_date": "2025-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./static"
  },
  "observability": {
    "traces": {
      "enabled": true
    },
    "logs": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": [
      // Fixed UTC schedule: 06:05 daily
      "5 6 * * *"
    ]
  },
  "keep_vars": true,
  "services": [{ "binding": "PODCAST_SITE_SERVICE", "service": "any-podcast" }],
  "browser": {
    "binding": "BROWSER"
  },
  "workflows": [
    {
      "name": "podcast-workflow",
      "binding": "PODCAST_WORKFLOW",
      "class_name": "PodcastWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [{
      "name": "CLOUDFLARE_RENDER_GATE",
      "class_name": "CloudflareRenderGate"
    }]
  },
  "migrations": [{ "tag": "render-gate-v1", "new_sqlite_classes": ["CloudflareRenderGate"] }],
  "kv_namespaces": [
    {
      "binding": "PODCAST_KV",
      "id": ""
    }
  ],
  "r2_buckets": [
    {
      "binding": "PODCAST_R2",
      "bucket_name": "any-podcast"
    }
  ],
  "vars": {
    "PODCAST_ID": "any-podcast",
    // Set to "preview" to hold generated episodes out of the public list/RSS.
    "PODCAST_SITE_URL": "https://your-podcast.example.com",
    "PODCAST_PUBLISH_MODE": "publish"
  }
}
