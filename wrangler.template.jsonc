/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "any-podcast",
  "main": "site-entry.mjs",
  "minify": true,
  "upload_source_maps": true,
  "compatibility_date": "2025-11-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "traces": {
      "enabled": true
    },
    "logs": {
      "enabled": true
    }
  },
  "placement": {
    "mode": "smart"
  },
  "keep_vars": true,
  "kv_namespaces": [{
    "binding": "PODCAST_KV",
    "id": ""
  }],
  "r2_buckets": [
    {
      "binding": "PODCAST_R2",
      "bucket_name": "any-podcast"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "any-podcast"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "any-podcast"
    },
    {
      "binding": "PODCAST_WORKER_SERVICE",
      "service": "any-podcast-worker"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "PUBLIC_PAGE_RENDERER", "class_name": "PublicPageRenderer" },
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache"
      },
      {
        "name": "NEXT_CACHE_DO_PURGE",
        "class_name": "BucketCachePurge"
      }
    ]
  },
  "migrations": [
    {
      "tag": "open-next",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache", "BucketCachePurge"]
    },
    { "tag": "public-page-renderer-v1", "new_sqlite_classes": ["PublicPageRenderer"] }
  ]
}
